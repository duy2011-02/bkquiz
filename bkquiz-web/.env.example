# Biến môi trường của BKquiz (bkquiz-web).
# Local: chép file này thành `.env.local` (không commit) rồi sửa giá trị.
# Production (Vercel + Supabase): xem docs/DEPLOYMENT_SUPABASE.md — bước 5 có bảng đầy đủ.

# ---------- Database (bắt buộc) ----------
# Local: Postgres trong docker-compose.yml (`docker compose up -d postgres`).
# Vercel: chuỗi Transaction pooler của Supabase, cổng 6543, kèm `?pgbouncer=true&connection_limit=1`.
DATABASE_URL="postgresql://bkquiz:bkquiz@localhost:5433/bkquiz?schema=public"

# ---------- Đăng nhập (Auth.js + Google) ----------
# Chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="thay-bang-chuoi-ngau-nhien"
# Google Cloud → OAuth client (xem GOOGLE_OAUTH_SETUP.md). Redirect URI: <domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# CHỈ DÙNG KHI CHẠY LOCAL: bỏ qua Google, đổi vai trò qua /api/dev/role?role=teacher|student.
# TUYỆT ĐỐI KHÔNG đặt trên Vercel / production (ai cũng vào được với quyền giáo viên).
DEV_BYPASS_AUTH=1

# Quản trị viên: duyệt yêu cầu làm giáo viên ở /dashboard/admin (email Google, phân cách bằng dấu phẩy).
# Không đặt thì không ai duyệt được giáo viên mới. Local (dev bypass) có thể dùng dev.teacher@bkquiz.local.
ADMIN_EMAILS="dev.teacher@bkquiz.local"

# ---------- Ảnh câu hỏi (src/server/storage.ts) — kho tương thích S3 ----------
# Local: MinIO trong docker-compose.yml (`docker compose up -d minio`, bucket bkquiz-media cho đọc công khai).
# Supabase: Project Settings → Storage → S3 Connection (endpoint, region, access key riêng — không phải service_role).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="bkquiz-media"
# URL công khai của ảnh. Bỏ trống = <S3_ENDPOINT>/<S3_BUCKET> (đúng với MinIO).
# Supabase: https://<project-ref>.supabase.co/storage/v1/object/public/bkquiz-media
# S3_PUBLIC_BASE_URL=

# ---------- Cron /api/sessions/auto ----------
# Có giá trị thì cron phải gửi `Authorization: Bearer <CRON_SECRET>` (Vercel Cron tự gửi); người đã đăng nhập
# (màn chiếu của giáo viên) vẫn gọi được. Bỏ trống khi chạy local.
# CRON_SECRET=

# ---------- Tuỳ chọn ----------
# Tắt rate limit API (src/server/rateLimit.ts) khi test tải / debug. Không đặt trên production.
# RATE_LIMIT_DISABLED=1
# Tắt Sentry khi build (nên đặt `true` trên Vercel nếu chưa cấu hình Sentry).
# NEXT_PUBLIC_SENTRY_DISABLED=true
# Arcjet (chống bot cho các trang, không áp cho /api): https://launch.arcjet.com
# ARCJET_KEY=
# PostHog analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_TELEMETRY_DISABLED=1
